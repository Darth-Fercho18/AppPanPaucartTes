<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardMovimiento"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <!-- Categoría - Concepto combinado -->
            <TextView
                android:id="@+id/tvConceptoMovimiento"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CATEGORÍA - Concepto"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Monto -->
            <TextView
                android:id="@+id/tvMontoMovimiento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S/ 0.00"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Nombre del Integrante / Tercero -->
        <TextView
            android:id="@+id/tvAsociadoMovimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Integrante: Nombre"
            android:textSize="13sp"
            android:textColor="#555555"
            android:visibility="gone"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Cuenta Bancaria -->
            <TextView
                android:id="@+id/tvCuentaMovimiento"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Efectivo"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- N° Comprobante -->
            <TextView
                android:id="@+id/tvComprobanteMovimiento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="N°: 000123"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginEnd="12dp"
                android:visibility="gone" />

            <!-- Fecha -->
            <TextView
                android:id="@+id/tvFechaMovimiento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00/00/0000"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
