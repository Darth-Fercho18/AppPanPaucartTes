<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvNombreAsociado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del Integrante"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDniAsociado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ID/DNI: 00000000"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvApoderado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apoderado: ..."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvCelularApoderado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cel. Apoderado: ..."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <!-- Spinner para las 6 opciones de estado de asistencia -->
        <Spinner
            android:id="@+id/spinnerEstadoAsistencia"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
