<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mi_color_fondo">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btnGuardarAsistencia"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <!-- Título Principal -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Registro de Asistencia"
                android:textColor="@color/mi_color_primario"
                android:textSize="24sp"
                android:textStyle="bold" />
            <!-- Etiqueta Actividad -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="SELECCIONA LA FECHA / ACTIVIDAD"
                android:textColor="@color/mi_color_primario"
                android:textSize="12sp"
                android:textStyle="bold" />
            <!-- CONTENEDOR HORIZONTAL: Spinner + Botón Agregar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <!-- Selector de Actividades -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_spinner"
                    android:padding="2dp">
                    <Spinner
                        android:id="@+id/spActividad"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:popupBackground="@color/mi_color_tarjeta"
                        android:popupTheme="@style/ThemeOverlay.AppCompat.DayNight"
                        android:spinnerMode="dropdown" />
                </LinearLayout>
                <!-- Botón de Editar Actividad (NUEVO) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditarActividad"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/mi_color_primario"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="✏️️"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    app:cornerRadius="12dp"
                    app:elevation="2dp" />
                <!-- Botón de "+" -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAgregarActividad"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:backgroundTint="@color/mi_color_primario"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    app:cornerRadius="12dp"
                    app:elevation="2dp" />
            </LinearLayout>
            <!-- Etiqueta Filtro -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="FILTRAR POR TIPO (REQUERIDO)"
                android:textColor="@color/mi_color_primario"
                android:textSize="12sp"
                android:textStyle="bold" />
            <!-- Selector de Filtro (FILA, NIÑOS, EX INTEGRANTE) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_spinner"
                android:padding="2dp">
                <Spinner
                    android:id="@+id/spFiltroTipoAsistencia"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:entries="@array/opciones_filtro_asistencia"
                    android:popupBackground="@color/mi_color_tarjeta"
                    android:popupTheme="@style/ThemeOverlay.AppCompat.DayNight"
                    android:spinnerMode="dropdown" />
            </LinearLayout>
            <!-- Texto de estado -->
            <TextView
                android:id="@+id/tvEstadoCarga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Esperando selección..."
                android:textColor="@color/mi_color_texto_principal"
                android:textSize="14sp" />
            <!-- Lista de tarjetas -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAsistencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <!-- Botón Inferior -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGuardarAsistencia"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="@color/mi_color_primario"
        android:text="GUARDAR"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:elevation="4dp" />
</RelativeLayout>