<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface_white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Nombre del Integrante -->
        <TextView
            android:id="@+id/tvNombreSocio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Nombre del Integrante"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnVerCuenta" />

        <!-- Lote o DNI -->
        <TextView
            android:id="@+id/tvDetalleSocio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lote: A-12"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNombreSocio" />

        <!-- Indicador de Estado -->
        <TextView
            android:id="@+id/tvEstadoSocio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Al día"
            android:textColor="@color/primary_green_light"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDetalleSocio" />

        <!-- Botón de Acción Rápida -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerCuenta"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cobrar"
            android:textColor="@color/accent_blue"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>